{
    "name": "pai3",
    "version": "1.0.0",
    "description": "NFT based ecosystem with trading, lending, rewards and vesting subsystems",
    "scripts": {
        "build": "forge build",
        "build-force": "forge build --force",
        "compile": "hardhat compile",
        "compile-force": "hardhat compile --force",
        "deploy-collections": "hardhat run scripts/deploy-collections.js",
        "deploy-collections-staging": "hardhat run scripts/deploy-collections.js --network staging",
        "deploy-token": "hardhat run scripts/deploy-token.js",
        "deploy-token-staging": "hardhat run scripts/deploy-token.js --network staging",
        "format": "prettier --check --write .prettierrc *.json {contracts,test}/**/*.sol {,scripts/}*.js",
        "test": "forge test",
        "test-force": "forge build --force && forge test",
        "test-log": "forge test -vv",
        "test-quick": "forge test --no-compile",
        "test-verbose": "forge test -vvvv"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MuhammadWaqas4/pai3"
    },
    "author": "PAI3 Team",
    "license": "MIT",
    "devDependencies": {
        "@chainlink/contracts": "1.3.0",
        "@nomicfoundation/hardhat-foundry": "^1.1.3",
        "@nomicfoundation/hardhat-toolbox": "^5.0.0",
        "@openzeppelin/contracts": "5.2.0",
        "dotenv": "^16.4.5",
        "envfile": "^7.1.0",
        "erc721a": "^4.3.0",
        "hardhat": "^2.22.17",
        "prettier": "^3.3.3",
        "prettier-plugin-package": "^1.4.0",
        "prettier-plugin-solidity": "^1.4.1",
        "prettier-plugin-sort-imports": "^1.8.6"
    }
}
