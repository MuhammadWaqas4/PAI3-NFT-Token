{
    "arrowParens": "always",
    "bracketSpacing": true,
    "importOrderTypeScriptVersion": "5.0.0",
    "overrides": [
        {
            "files": "*.js",
            "options": {
                "printWidth": 120
            }
        }
    ],
    "plugins": [
        "@ianvs/prettier-plugin-sort-imports",
        "prettier-package-json",
        "prettier-plugin-solidity"
    ],
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false
}